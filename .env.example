# Configure securely in your hosting provider; do not commit real secrets.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
SECRET_KEY=replace-with-a-long-random-secret
BOOTSTRAP_PASSWORD=replace-with-a-strong-password-at-least-12-chars
CORS_ORIGINS=https://your-frontend.vercel.app
NODE_ENV=production
